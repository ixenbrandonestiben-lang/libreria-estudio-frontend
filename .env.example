# ==============================================================================
# Librería Estudio - Frontend (.env.example)
# Copia este archivo a .env y ajusta los valores según tu entorno.
# ==============================================================================

# Puerto público del contenedor Nginx
FRONTEND_PORT=8080

# URL base de la API Backend
API_BASE_URL=http://localhost:3000/api/v1

# Dominio público del sitio (usado para SEO / referencia)
SITE_URL=https://libreria-estudio.example.com
